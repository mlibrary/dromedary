<%# Given presenter: doc_presenter  %>

<div class="sense">
  <% presenter.sensestuff.each_with_index do |ss, index| %>
    <% base_class_name = ss.class.name.split(/::/).last.downcase %>
    <% if base_class_name == "SENSE" %>
      <%= render partial: "catalog/show_entry/sense", locals: { sense: ss, index: index, presenter: presenter } %>
    <% else %>
      <%= render partial: "catalog/show_entry/#{base_class_name}", locals: { sense: ss, sensegrp: ss, supplement: ss, note: ss, index: index, presenter: presenter } %>
    <% end %>
  <% end %>
</div>
