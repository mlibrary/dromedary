<div id="sortAndPerPage" class="clearfix">
  <%= render :partial => "paginate_compact", :object => @response if show_pagination? %>
  <span class="search-term-filter"><%= render 'query_constraint' %></span>
  <span class="search-widgets float-right">
    <%= render 'sort_widget' %>
    <%= render 'per_page_widget' %>
    <%= render_results_collection_tools %>
  </span>

  <%= render "application/phrase_wildcard" %>
</div>
