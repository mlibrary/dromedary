<% content_for :h1_wrap do %>
  <h1 class="visually-hidden"><%= Array(@document["headword"]).first %></h1>
<% end %>

<div id="sidebar" class="<%= show_sidebar_classes %>">
   <%= render partial: 'related_entries' %>
</div>

<div id="content" class="<%= show_content_classes %>">
  <% presenter = document_presenter(@document) %>
  <%= render 'show_main_content', presenter: presenter %>
</div>