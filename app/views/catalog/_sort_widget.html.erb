<% if show_sort_and_per_page? and active_sort_fields.many? %>
<div id="sort-dropdown" class="btn-group">
  <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
      <%= t('blacklight.search.sort.label', :field =>current_sort_field.label) %> <span class="caret"></span>
  </button>

  <div class="dropdown-menu" role="menu">
      <%- active_sort_fields.each do |sort_key, field_config| %>
        <% is_active = (sort_key.to_s == current_sort_field.key.to_s) %>
        <%= link_to(field_config.label, url_for(search_state.params_for_search(sort: sort_key)), class: "dropdown-item#{' active' if is_active}", 'aria-current': ('page' if is_active)) %>
      <%- end -%>
  </div>
</div>
<% end %>
