<%#= replace :head do %>
  <%#= link_to_repository %>
<% #end %>

<% content_for :skiplinks do %>
  <%= render 'catalog/index_skiplinks' %>
<% end %>

<%# require 'pry'; binding.pry %>


<section class="quotations-home">
	<h1>MEC Quotation Search</h1> 
	<div class="home-description">
<p>  Quotations illustrate the use of a word.
  This search helps you find a designated word,
  phrase, or combination of words within
  stencils and quotations.</p>
  </div>

	<div class="search-bar-label">Search quotations:</div>
	<div class="search-bar--light-bg">
	  <%= render Blacklight::SearchBarComponent.new(url: search_action_url, params: search_state.params_for_search.except(:qt), autocomplete_path: "#{suggest_index_quotes_path}?base_url=#{ERB::Util.url_encode("#{root_path}quotations")}", classes: %w[search-query-form]) do |component| %>
	    <% component.with_append do %>
	      <%= render 'shared/keyboard_dropdown' %>
	    <% end %>
	  <% end %>
	</div>
</section>

