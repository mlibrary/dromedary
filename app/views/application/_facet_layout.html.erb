<div class="card facet_limit blacklight-<%= facet_field.key.parameterize %> <%= 'facet_limit-active' if facet_field_in_params?(facet_field.key) %>">
  <div class="<%= "collapsed" if should_collapse_facet?(facet_field) %> collapse-toggle card-header" data-bs-toggle="collapse" data-bs-target="#<%= facet_field_id(facet_field) %>">
    <h3 class="facet-field-heading">
      <%= link_to facet_field_label(facet_field.key), "#", :"data-no-turbolink" => true %>
    </h3>
  </div>
  <div id="<%= facet_field_id(facet_field) %>" class="facet-content <%= should_collapse_facet?(facet_field) ? 'collapse' : 'collapse show' %>">
    <div class="card-body">
      <%= yield %>
    </div>
  </div>
</div>
