<% # main container for facets/limits menu -%>
<% if has_facet_values?  %>
<div id="facets" class="facets sidenav">

  <div class="top-card-header card-header">
    <button type="button" class="facets-toggle" data-bs-toggle="collapse" data-bs-target="#facet-panel-collapse">
      <span class="visually-hidden">Toggle facets</span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>

    <h3 class='facets-heading'>
      <%= t('blacklight.search.facets.title') %>
    </h3>
  </div>

  <div id="facet-panel-collapse" class="collapse panel-group">
    <%= render Blacklight::FacetComponent.with_collection(blacklight_config.facet_fields.values, response: @response) %>
  </div>
</div>
<% end %>
