<%#= replace :head do %>
  <%#= link_to_repository %>
<% #end %>

<% content_for :skiplinks do %>
  <%= render 'catalog/index_skiplinks' %>
<% end %>


<section class="bib-home">
	<h1>MEC Bibliography Search</h1> 
	<div class="home-description">
	  Bibliography results include only the manuscripts and editions
	  used in the compilation of the Middle English Dictionary.
  </div>

	<div class="search-bar-label">Search bibliographic entries:</div>
	<div class="search-bar--light-bg">
	  <%= render Blacklight::SearchBarComponent.new(url: search_action_url, params: search_state.params_for_search.except(:qt), autocomplete_path: "#{suggest_index_bibliography_path}?base_url=#{ERB::Util.url_encode("#{root_path}bibliography")}") do |component| %>
	    <% component.with_append do %>
	      <%= render 'shared/keyboard_dropdown' %>
	    <% end %>
	  <% end %>
	</div>
</section>
