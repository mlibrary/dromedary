<span class="dropdown keyboard">
  <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <%= image_tag('keyboard-grey.svg', alt: 'Drop down menu for special character selection') %>
  </button>
  <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
    <ul class="keyboard-list">
      <li><a href="#" class="keyboard-char dropdown-item" data-char="þ" role="button">Þ þ (thorn)</a></li>
      <li><a href="#" class="keyboard-char dropdown-item" data-char="ð" role="button">Ð ð (eth)</a></li>
      <li><a href="#" class="keyboard-char dropdown-item" data-char="ʒ" role="button">Ʒ ʒ (yogh)</a></li>
      <li><a href="#" class="keyboard-char dropdown-item" data-char="æ" role="button">Æ æ (ash)</a></li>
    </ul>
  </div>
</span>
